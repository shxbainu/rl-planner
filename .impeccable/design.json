  "components": [
    {
      "name": "Leaf",
      "kind": "card",
      "refersTo": "leaf",
      "description": "Milk-white punched leaf on the cloth board; every work area is one.",
      "html": "<div class=\"ds-board\"><section class=\"ds-leaf\"><h2 class=\"ds-h\">Homework</h2><p>Latin: translate lines 40 to 60.</p><p>English: read chapter 4.</p></section></div>",
      "css": ".ds-board{background:#2b6650;padding:22px;font:14.5px/1.5 Archivo,system-ui,sans-serif}.ds-leaf{position:relative;background:#fbf8ef;color:#1b1a17;border-radius:3px;padding:16px 18px 16px 34px;box-shadow:3px 3px 0 rgb(0 0 0 / .2),0 10px 24px -14px rgb(0 0 0 / .45)}.ds-leaf::before,.ds-leaf::after{content:'';position:absolute;left:10px;top:54px;width:14px;height:14px;border-radius:50%;background:#2b6650;box-shadow:inset 2px 2px 3px rgb(0 0 0 / .5),0 0 0 2px #f2eee2,0 0 0 3px #ddd6c4}.ds-leaf::after{top:122px}.ds-h{margin:0 0 8px;font:700 16px/1.2 'Archivo Narrow',Archivo,sans-serif;letter-spacing:.06em;text-transform:uppercase}"
    },
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Leaf-white with a 1.5px ink rule; steps on press.",
      "html": "<button class=\"ds-btn\">Study</button>",
      "css": ".ds-btn{border-radius:4px;background:#fbf8ef;border:1.5px solid #1b1a17;color:#1b1a17;font:700 14px Archivo,system-ui,sans-serif;padding:7px 14px;cursor:pointer;transition:transform .09s steps(2)}.ds-btn:hover{background:#f2eee2}.ds-btn:active{transform:translate(1px,1px)}.ds-btn:focus-visible{outline:2px solid #1b1a17;outline-offset:2px}"
    },
