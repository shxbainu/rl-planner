      "css": ".ds-btn-primary{border-radius:4px;background:#1b1a17;border:1.5px solid #1b1a17;color:#fbf8ef;font:700 14px Archivo,system-ui,sans-serif;padding:7px 14px;cursor:pointer;transition:transform .09s steps(2)}.ds-btn-primary:active{transform:translate(1px,1px)}.ds-btn-primary:focus-visible{outline:2px solid #1b1a17;outline-offset:2px}"
    },
    {
